# SirenDeck — environment variable template.
# Copy to .env.local for local work.
# NEVER put service-role keys, client secrets, or vault values in this repo.

# ── Supabase (production `main` / dual-run until cutover) ───────────────────
# Supabase project URL (public by design)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (public by design, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-only Supabase secret key (admin operations): set in Vercel only,
# injected by the Vercel Marketplace Supabase integration. Never commit.

# ── Edge Function: send-reminders (set in Supabase dashboard, not Vercel) ──
# Reminder dispatch mode. "log" prints what would be sent and costs nothing.
# A real email provider is wired only after explicit approval + secrets.
# REMINDER_MODE=log

# ── SELISE Blocks OS (migration on `dev`) ───────────────────────────────────
# Public values only. This app uses a public PKCE OIDC client — NEVER put a
# client_secret in the frontend or commit one here.
#
# Cookie-based hosted login requires HTTPS on a domain that shares a
# registrable domain with NEXT_PUBLIC_BLOCKS_API_URL. Plain http://localhost
# will complete the redirect but the session cookie will not stick; for local
# login testing use HTTPS on the project domain (see blocks-frontend-local-https
# / Migration.md). Callback path is always /login/callback.

# Project tenant key (x-blocks-key header). Dev env SirenDeck:
NEXT_PUBLIC_BLOCKS_KEY=D158bd535e4d44ea58e5c53146704e2ab

# API base for @seliseblocks/client. For *.slsblx.com apps this MUST be the
# blocksapi host on the same registrable domain (not api.seliseblocks.com),
# or the session cookie is treated as cross-site and never stored.
NEXT_PUBLIC_BLOCKS_API_URL=https://blocksapi.slsblx.com

# OIDC issuer / metadata URL (public). Matches tenant discovery issuer.
NEXT_PUBLIC_BLOCKS_OIDC_URL=https://iam.seliseblocks.com/D158bd535e4d44ea58e5c53146704e2ab

# Public OIDC client id (PKCE; tokenEndpointAuthMethod=none). Not a secret.
NEXT_PUBLIC_BLOCKS_OIDC_CLIENT_ID=e6307866-2c00-42c3-b94d-d63c6581c9ed

# Optional; SDK defaults to "openid profile" if unset.
NEXT_PUBLIC_BLOCKS_OIDC_SCOPE=openid profile

# App origins whose /login/callback is registered on this client:
#   https://dblcyi-eocee.slsblx.com/login/callback
#   http://localhost:3000/login/callback
